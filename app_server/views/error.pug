extends layout

block content
  include navbar

  main.d-flex.flex-column.align-items-center.justify-content-center.text-center.px-3(style="min-height: 80vh;")
    h1.display-1.fw-bold.text-danger= status || 500
    p.fs-4.mb-1= message || "Something went wrong"
    p.text-secondary.mb-4
      if status === 404
        | The page you're looking for doesn't exist or may have been removed.
      else
        | Please try again in a moment.
    a.btn.btn-danger.px-4(href="/home") Back to home