extends layout 

block content
    section.auth-page.position-relative.d-flex.flex-column.min-vh-100.bg-custom-image
        .wall(aria-hidden="true")

        .card.auth-card.mx-auto.my-auto(style="width: min(90%, 550px);")
            .card-body.p-4.p-sm-5
                .d-flex.justify-content-center.mb-4
                    a(href="/")
                        img(src="/images/logo/streamit_logo_full.png", alt="Streamit" width="180")

                .text-center.mb-4
                    h3.fw-semibold.mb-1 Sign up
                    p.text-secondary.small.mb-0 Create an account to start watching.

                if error
                    .alert.alert-danger.small.py-2.px-3.d-flex.align-items-start.gap-2.border-0
                        i.bi.bi-exclamation-triangle-fill.flex-shrink-0.mt-1
                        div
                            div= error
                            if errorsList && errorsList.length
                                ul.error-list.mb-0.mt-1.ps-3
                                    each item in errorsList
                                        li= item

                form(method="post" action="/signup" novalidate)
                    .mb-3
                        label.form-label.small.text-secondary(for="firstname") First name
                        .input-group.auth-input
                            span.input-group-text: i.bi.bi-person
                            input#firstname.form-control(type="text" name="firstname" placeholder="First name" value=(values && values.firstname) maxlength="50" pattern="[\\p{L}'\\- ]+" required autocomplete="given-name")

                    .mb-3
                        label.form-label.small.text-secondary(for="lastname") Last name
                        .input-group.auth-input
                            span.input-group-text: i.bi.bi-person
                            input#lastname.form-control(type="text" name="lastname" placeholder="Last name" value=(values && values.lastname) maxlength="50" pattern="[\\p{L}'\\- ]+" required autocomplete="family-name")

                    .mb-3
                        label.form-label.small.text-secondary(for="email") Email address
                        .input-group.auth-input
                            span.input-group-text: i.bi.bi-envelope
                            input#email.form-control(type="email" name="email" placeholder="you@email.com" value=(values && values.email) required autocomplete="email")

                    .mb-4
                        label.form-label.small.text-secondary(for="password") Password
                        .input-group.auth-input
                            span.input-group-text: i.bi.bi-lock
                            input#password.form-control(type="password" name="password" placeholder="••••••••" minlength="8" maxlength="50" required autocomplete="new-password")
                            button.input-group-text.btn-toggle-pw(type="button" tabindex="-1" aria-label="Show password")
                                i.bi.bi-eye

                    button.btn.btn-danger.w-100.fw-semibold.py-2(type="submit") Sign up

                .text-center.small.mt-4.text-secondary
                    | Already have an account?
                    a.auth-link.ms-1(href="/signin") Sign in

    script.
        const form = document.querySelector('form');
        form.addEventListener('submit', function () {
            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Creating account...';
        });

        const toggle = document.querySelector('.btn-toggle-pw');
        toggle.addEventListener('click', function () {
            const pw = document.getElementById('password');
            const icon = this.querySelector('i');
            const show = pw.type === 'password';
            pw.type = show ? 'text' : 'password';
            icon.classList.toggle('bi-eye', !show);
            icon.classList.toggle('bi-eye-slash', show);
        });