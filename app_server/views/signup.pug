extends layout 

block content
    section.position-relative.d-flex.flex-column.min-vh-100.bg-custom-image
        .wall(aria-hidden="true")

        header.d-flex.justify-content-center.align-items-center.p-5
            a(href="/") 
                img(src="/images/logo/streamit_logo_full.png", alt="Streamit logo" width="200")
        
        .card.auth-card.mx-auto(style="width: min(90%, 480px);")
            .card-body.p-4
                h1.h3.fw-light.mb-1 Sign up
                p.text-secondary.small.mb-4 Create an account to start watching.

                if error
                    .alert.alert-danger.d-flex.align-items-center.gap-2.small.py-2(role="alert")
                        i.bi.bi-exclamation-triangle-fill.flex-shrink-0
                        span= error

                form(method="post" action="/signup" novalidate)
                    .mb-3
                        label.form-label.small(for="firstname") First name
                        .input-group
                            span.input-group-text.border-0: i.bi.bi-person
                            //- https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Attributes/pattern
                            input#firstname.form-control(type="text" name="firstname" placeholder="First name" value=(values && values.firstname) maxlength="50" pattern="[\\p{L}'\\- ]+" required autocomplete="given-name")
                    
                    .mb-3
                        label.form-label.small(for="lastname") Last name
                        .input-group
                            span.input-group-text.border-0: i.bi.bi-person
                            input#lastname.form-control(type="text" name="lastname" placeholder="Last name" value=(values && values.lastname) maxlength="50" pattern="[\\p{L}'\\- ]+" required autocomplete="family-name")

                    .mb-3
                        label.form-label.small(for="email") Email address
                        .input-group
                            span.input-group-text.border-0: i.bi.bi-envelope
                            input#email.form-control(type="email" name="email" placeholder="youremail@email.com" value=(values && values.email) required autocomplete="email")
                    
                    .mb-3
                        label.form-label.small(for="password") Password
                        .input-group
                            span.input-group-text: i.bi.bi-lock
                            input#password.form-control(type="password" name="password" placeholder="********" minlength="8" maxlength="50" required autocomplete="new-password")
                    
                    button.btn.btn-danger.w-100(type="submit") Sign up
                
                .d-flex.flex-column.flex-sm-row.align-items-left.gap-1.mt-4.small
                    span Already have an account?
                    a.text-decoration-underline.text-black(href="/signin") Sign in
    
    script.
        document.querySelector('form').addEventListener('submit', function () {
            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Creating account...';
        });