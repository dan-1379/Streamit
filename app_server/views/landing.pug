extends layout

block content
  section.landing.position-relative.d-flex.flex-column.min-vh-100.bg-custom-image
    .wall(aria-hidden='true')

    header.position-relative.d-flex.justify-content-between.align-items-center.p-3.px-md-5
      a(href="/")
        img(src="/images/logo/streamit_logo_full.png", alt="Streamit" width="150")
      nav.d-flex.align-items-center.gap-3
        a.text-white.text-decoration-none.small.d-none.d-sm-inline(href='/signup') Join
        a.btn.btn-danger.btn-sm.fw-semibold.px-3(href='/signin') Sign in

    main.position-relative.flex-grow-1.d-flex.flex-column.align-items-center.justify-content-center.text-center.text-white.px-3.py-5
      h1.display-3.fw-bold.landing-headline.mb-3 A universe of stories awaits
      p.fs-5.text-light.mb-4.landing-sub Unlimited films and series. Watch anywhere. Start whenever you like.
      a.btn.btn-danger.btn-lg.fw-semibold.px-5.py-3(href='/signup')
        | Get Started
        i.bi.bi-chevron-right.ms-2

      .row.g-4.mt-5.landing-features
        .col-12.col-md-4
          .feature-card.h-100.p-4.rounded-3
            i.bi.bi-tv.fs-2.text-danger.mb-3
            h3.h6.fw-semibold Watch anywhere
            p.small.text-secondary.mb-0 Stream on your laptop, tablet or phone, anytime.
        .col-12.col-md-4
          .feature-card.h-100.p-4.rounded-3
            i.bi.bi-collection-play.fs-2.text-danger.mb-3
            h3.h6.fw-semibold Thousands of titles
            p.small.text-secondary.mb-0 From blockbuster films to binge-worthy series.
        .col-12.col-md-4
          .feature-card.h-100.p-4.rounded-3
            i.bi.bi-stars.fs-2.text-danger.mb-3
            h3.h6.fw-semibold Always something new
            p.small.text-secondary.mb-0 Fresh stories added so there's always more to watch.