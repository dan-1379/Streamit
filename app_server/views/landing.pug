extends layout

block content
  section.position-relative.d-flex.flex-column.min-vh-100
    .wall(aria-hidden='true')
    
    header.d-flex.justify-content-center.justify-content-sm-between.align-items-center.p-3
        a.text-white.text-decoration-none.fs-4(href='/') LOGO

        nav.d-none.d-sm-flex.align-items-center.gap-3
            a.btn.btn-danger.btn-sm.text-uppercase(href='/signin') Sign in
            a.text-white.text-decoration-none.text-uppercase(href='/signup') Join
    main.flex-grow-1.d-flex.flex-column.align-items-center.justify-content-center.text-center.gap-4.px-3.pb-5
        h1.display-3.fw-light.landing-headline A universe of stories awaits
        p.fs-4 Ready to watch? Get started using the link below.
        a.btn.btn-danger.btn-lg.px-5(href='/signup') Get Started
