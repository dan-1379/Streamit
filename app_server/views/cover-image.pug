header.hero-section.position-relative.d-flex.align-items-center.text-white.p-4.p-md-5(
    style=`background: linear-gradient(to right, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.4) 50%, rgba(0, 0, 0, 0) 100%), linear-gradient(to top, #000 0%, transparent 20%), url('${hero.coverImage || hero.image}') center 25%/cover no-repeat;`
)
    .container-fluid.py-5
        .position-absolute.top-0.left-0.py-2
            img(src="/images/logo/streamit_logo_s.png" alt="Logo" width="25" height="40")

        h1.fs-3.fw-bold.mb-2= hero.title

        .d-flex.align-items-center.gap-2.mb-3.text-light.small
            span= hero.year
            span= hero.seasons
            span.badge.bg-secondary.border.border-light= hero.rating
        
        p.lead.fs-6.text-light.mb-4= hero.description
        
        .d-flex.gap-2
            a.btn.btn-light.fw-semibold.d-flex.align-items-center.gap-2.px-4(href=`/title/${hero._id}`)
                i.bi.bi-play-fill
                | Play
            
            a.btn.btn-outline-light.fw-semibold.px-4(href=`/title/${hero._id}`)
                | More Info